// LAW house style for proposals and reports: a pandoc Typst template (pandoc --template, --pdf-engine=typst).
// Cover page, contents, numbered sections, shaded tables, header/footer with page numbers.
#let accent = rgb("#0b3d2e")
#let accent-light = rgb("#e8f0ec")
#let muted = rgb("#5b6770")
#let horizontalrule = line(length: 100%, stroke: 0.5pt + muted)

#show terms.item: it => block(breakable: false)[
  #text(weight: "bold")[#it.term]
  #block(inset: (left: 1.5em, top: -0.4em))[#it.description]
]

$if(highlighting-definitions)$
$highlighting-definitions$
$endif$

#set document(title: "$title$")
#set text(font: ("Helvetica Neue", "Arial", "Libertinus Serif"), size: 10.5pt, lang: "en", fill: rgb("#1d2327"))
#set par(justify: false, leading: 0.68em, spacing: 1.05em)
#set page(paper: "a4", margin: (x: 2.2cm, top: 2.4cm, bottom: 2.4cm))

// ---- cover ----
#page(margin: 0pt, header: none, footer: none)[
  #rect(width: 100%, height: 100%, fill: accent, inset: (x: 2.4cm, y: 3cm))[
    #set text(fill: white)
    #v(1fr)
    #text(size: 11pt, tracking: 2pt, weight: "bold")[$if(kind)$$kind$$else$PROPOSAL$endif$]
    #v(0.6cm)
    #text(size: 30pt, weight: "bold")[$title$]
$if(subtitle)$
    #v(0.4cm)
    #text(size: 15pt)[$subtitle$]
$endif$
    #v(1.6cm)
    #line(length: 30%, stroke: 1.5pt + white)
    #v(0.5cm)
$if(prepared-for)$
    #text(size: 11pt)[Prepared for: $prepared-for$] \
$endif$
$if(author)$
    #text(size: 11pt)[Prepared by: $for(author)$$author$$sep$, $endfor$] \
$endif$
$if(date)$
    #text(size: 11pt)[$date$]
$endif$
    #v(2cm)
  ]
]

// ---- body pages ----
#set page(
  header: context {
    if counter(page).get().first() > 1 [
      #set text(size: 8.5pt, fill: muted)
      $title$ #h(1fr) Confidential
      #v(-0.6em)
      #line(length: 100%, stroke: 0.4pt + muted)
    ]
  },
  footer: context [
    #set text(size: 8.5pt, fill: muted)
    #h(1fr) #counter(page).display("1")
  ],
)
#counter(page).update(1)

#set heading(numbering: "1.1")
#show heading.where(level: 1): it => {
  pagebreak(weak: true)
  v(0.4cm)
  block(below: 0.9em)[
    #text(size: 19pt, weight: "bold", fill: accent)[#if it.numbering != none [#counter(heading).display() #h(0.4em)]#it.body]
    #v(-0.5em)
    #line(length: 100%, stroke: 1.2pt + accent)
  ]
}
#show heading.where(level: 2): it => block(above: 1.4em, below: 0.7em)[
  #text(size: 13.5pt, weight: "bold", fill: accent)[#if it.numbering != none [#counter(heading).display() #h(0.3em)]#it.body]
]
#show heading.where(level: 3): it => block(above: 1.1em, below: 0.6em)[
  #text(size: 11.5pt, weight: "bold")[#it.body]
]

#set table(
  inset: (x: 7pt, y: 5.5pt),
  stroke: (x, y) => (bottom: 0.4pt + rgb("#c9d1d6")),
  fill: (x, y) => if y == 0 { accent } else if calc.even(y) { accent-light } else { none },
)
#show table.cell.where(y: 0): set text(fill: white, weight: "bold")
#show table: set text(size: 9.5pt)
#show figure.where(kind: table): set figure.caption(position: top)
#show figure.caption: set text(size: 9pt, fill: muted, style: "italic")
#show figure: set block(breakable: true)
#show quote: it => block(fill: accent-light, inset: 10pt, radius: 3pt, width: 100%, stroke: (left: 3pt + accent))[#it.body]
#show raw.where(block: true): it => block(fill: rgb("#f4f6f7"), inset: 8pt, radius: 3pt, width: 100%)[#text(size: 8.5pt)[#it]]
#show link: set text(fill: accent)

$for(header-includes)$
$header-includes$
$endfor$

#outline(title: [Contents], depth: 2, indent: auto)
#pagebreak()

$body$
